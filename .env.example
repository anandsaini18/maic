# Copy to .env and edit as needed
#
# No-token models (recommended to start):
#   mlx-community/Phi-3.5-mini-instruct-4bit      MIT license  ~2.3 GB  ← default
#   mlx-community/SmolLM2-1.7B-Instruct-4bit      Apache 2.0   ~1.0 GB  (fastest)
#   mlx-community/Qwen3-4B-Instruct-2507-4bit     Apache 2.0   ~2.5 GB
#
# Token required (accept license at hf.co first):
#   mlx-community/Llama-3.2-3B-Instruct-4bit      Meta license ~1.8 GB
#   mlx-community/Llama-3.1-8B-Instruct-4bit      Meta license ~4.9 GB
#
MODEL_ID=mlx-community/Phi-3.5-mini-instruct-4bit
# Where model weights are stored — independent of HF cache, survives .env deletion.
# Change to an external drive path if disk space is tight:
# MODELS_DIR=/Volumes/MyDrive/models
MODELS_DIR=~/models
HOST=0.0.0.0
PORT=8000
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_P=0.9
